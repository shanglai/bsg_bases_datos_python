# =====================================================================
# c2_s1_b2_env_ejemplo.txt
# Sesion 2.1: plantilla del archivo de credenciales
#
# Uso:
#   1. Copiar este archivo con el nombre .env en el directorio de trabajo
#   2. Sustituir el valor de POSTGRES_PASSWORD
#   3. Agregar .env al archivo .gitignore
#
# El archivo .env NO se versiona ni se comparte. Esta plantilla si.
# Ese es el motivo de que existan los dos.
# =====================================================================

# Credenciales del servidor. El contenedor las usa para crear el
# usuario y la base la primera vez que arranca.
POSTGRES_USER=curso
POSTGRES_PASSWORD=cambiar_este_valor
POSTGRES_DB=pagos

# Parametros de conexion que usa el codigo de Python.
PGHOST=localhost
PGPORT=5432

# ---------------------------------------------------------------------
# Nota sobre el ejercicio del curso
#
# La contrasena de este entorno protege una base local con datos
# sinteticos, de modo que su valor no tiene consecuencia practica.
# El proposito del ejercicio es la practica: la credencial se lee del
# entorno y nunca aparece en el codigo fuente.
#
# En un entorno productivo, el archivo .env es el escalon mas basico.
# Por encima estan los servicios de gestion de secretos, que rotan las
# credenciales y registran cada acceso.
# ---------------------------------------------------------------------
